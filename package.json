{
  "name": "projektplattform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "python main.py --no-browser",
    "build": "next build",
    "start": "python main.py --production --no-browser",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts *.ts *.json *.mjs docs README.md tests/e2e",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s tests -v",
    "test:e2e": "playwright test",
    "test:reference": "playwright test --config playwright.reference.config.ts",
    "test:runtime": "python tests/support/check_launcher.py",
    "db": "node --conditions=react-server scripts/database.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.1"
  }
}
