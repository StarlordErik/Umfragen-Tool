# Platform: Node.js 24 LTS. Python 3.12+ is only needed for Olive.
# Paths are relative to the repository root. Never overwrite an existing .env.
HOST=0.0.0.0
PORT=8000
# The homepage starts independently of all OLIVE_* settings.
OLIVE_ENABLED=true
# Required only for Olive. Existing local password is preserved in .env.
OLIVE_ADMIN_PASSWORD=
# Keep the existing database in place. UMFRAGEN_DB / UMFRAGEN_PINS remain aliases.
OLIVE_DATABASE_PATH=data/umfragen.sqlite3
OLIVE_PINS_PATH=Oliven-Symposium-Momentaufnahme-PINs.txt
# Internal OLIVE_LEGACY_ORIGIN is assigned by the launcher; never expose this port.
# Optional: absolute Python executable path (no shell arguments).
# Default: .venv interpreter if present, otherwise python on Windows / python3 on Unix.
# OLIVE_PYTHON=C:/path/to/python.exe
# OLIVE_STARTUP_TIMEOUT_MS=15000
